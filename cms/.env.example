# Copy to .env and fill in real values. Without DATABASE_URL the CMS uses SQLite.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
SERVE_BASE_URL=http://localhost:3000

# Media storage. Leave AWS_STORAGE_BUCKET_NAME unset to keep media on local disk.
# Set it (plus creds/endpoint) to switch STORAGES["default"] to S3.
# AWS_STORAGE_BUCKET_NAME=education-media
# AWS_S3_ENDPOINT_URL=https://s3.example.internal
# AWS_S3_REGION_NAME=ap-southeast-2
# AWS_S3_CUSTOM_DOMAIN=media.example.internal
# AWS_S3_QUERYSTRING_AUTH=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
